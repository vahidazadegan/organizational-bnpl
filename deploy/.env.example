# Copy to deploy/.env on the VPS (never commit the real file).

BASE_DOMAIN=example.com
ACME_EMAIL=ops@example.com

DB_NAME=bnpl_db
DB_USER=bnpl
DB_PASSWORD=change-me-strong-db-password

# Shared HS256 secret for all services in the test env (min 32 chars)
JWT_SECRET=change-me-to-a-test-secret-key-32b-min

# Optional fixed OTP for customer + merchant flows in test
OTP_FIXED_CODE=123456

# Public API URLs baked into Next.js builds (must match Caddy hosts)
ADMIN_API_PUBLIC_URL=https://api-admin.example.com
PANEL_API_PUBLIC_URL=https://api-org.example.com
CUSTOMER_API_PUBLIC_URL=https://api-app.example.com

# CORS origins for browser UIs (must match Caddy UI hosts)
ADMIN_CORS_ORIGINS=https://admin.example.com
PANEL_CORS_ORIGINS=https://org.example.com
CUSTOMER_CORS_ORIGINS=https://app.example.com

# Optional: container base images when Docker Hub returns 403
# NODE_RUNTIME_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# JAVA_RUNTIME_IMAGE=public.ecr.aws/amazoncorretto/amazoncorretto:21
# POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:18.6
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2.10-alpine
