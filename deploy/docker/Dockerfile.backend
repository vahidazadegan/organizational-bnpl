# syntax=docker/dockerfile:1
# Runtime-only image. Build the JAR on the host first, then set compose context to a
# directory that contains app.jar (see scripts/deploy-test.sh).
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN useradd --system --create-home --uid 10001 appuser
COPY app.jar /app/app.jar
USER appuser
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
