# syntax=docker/dockerfile:1
# Build context: repository `service/` directory
# Maven artifacts: BuildKit cache on the host (repo shared; wrapper locked to avoid races).
ARG SERVICE_MODULE=organization-panel-service

FROM eclipse-temurin:21-jdk-jammy AS build
ARG SERVICE_MODULE
WORKDIR /workspace

COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
COPY libs/domain/pom.xml libs/domain/
COPY libs/dto/pom.xml libs/dto/
COPY organization-panel-service/pom.xml organization-panel-service/
COPY customer-service/pom.xml customer-service/
COPY admin-service/pom.xml admin-service/
COPY merchant-service/pom.xml merchant-service/

RUN chmod +x mvnw

# Wrapper install must be locked (parallel compose builds previously corrupted ~/.m2/wrapper).
# Artifact repository stays shared across SERVICE_MODULE images.
RUN --mount=type=cache,id=bnpl-maven-wrapper-v2,target=/root/.m2/wrapper,sharing=locked \
	--mount=type=cache,id=bnpl-maven-repo-v2,target=/root/.m2/repository,sharing=shared \
	./mvnw -B -pl "${SERVICE_MODULE}" -am dependency:go-offline -DskipTests

COPY libs libs
COPY organization-panel-service organization-panel-service
COPY customer-service customer-service
COPY admin-service admin-service
COPY merchant-service merchant-service

RUN --mount=type=cache,id=bnpl-maven-wrapper-v2,target=/root/.m2/wrapper,sharing=locked \
	--mount=type=cache,id=bnpl-maven-repo-v2,target=/root/.m2/repository,sharing=shared \
	./mvnw -B -pl "${SERVICE_MODULE}" -am package -DskipTests \
	&& JAR="$(find "${SERVICE_MODULE}/target" -maxdepth 1 -type f -name "*.jar" ! -name "*.original" | head -n 1)" \
	&& cp "${JAR}" /workspace/app.jar

FROM eclipse-temurin:21-jre-jammy AS runtime
WORKDIR /app
RUN useradd --system --create-home --uid 10001 appuser
COPY --from=build /workspace/app.jar /app/app.jar
USER appuser
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
