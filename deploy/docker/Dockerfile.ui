# syntax=docker/dockerfile:1
# Runtime-only image. Build Next.js (output: standalone) on the host first.
# Build context: the UI app directory after `pnpm build`.
#
# Default base avoids Docker Hub 403 in restricted networks (override via NODE_RUNTIME_IMAGE).
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
FROM ${NODE_IMAGE}
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nextjs && adduser -S nextjs -G nextjs
COPY public ./public
COPY .next/standalone ./
COPY .next/static ./.next/static
RUN chown -R nextjs:nextjs /app
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
