# syntax=docker/dockerfile:1
# Runtime-only image. Build Next.js (output: standalone) on the host first.
# Build context: the UI app directory after `pnpm build`.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup -S nextjs && adduser -S nextjs -G nextjs
COPY public ./public
COPY .next/standalone ./
COPY .next/static ./.next/static
RUN chown -R nextjs:nextjs /app
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
